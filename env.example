# Variables d'environnement requises par le serveur (jamais commitées avec de vraies valeurs).
# À définir dans les réglages "Environment Variables" de l'hébergeur (Railway/Render), jamais dans le code.

# Chaîne de connexion PostgreSQL Supabase (Settings > Database > Connect > Connection string > URI > Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# URL du projet Supabase (Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Clé secrète serveur (Settings > API Keys > Secret keys, ou Legacy API Keys > service_role)
# Ne JAMAIS exposer cette clé au navigateur — elle contourne les règles de sécurité (RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Port HTTP du serveur (fourni automatiquement par la plupart des hébergeurs)
PORT=4000
