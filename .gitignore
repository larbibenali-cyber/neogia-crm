# Ancienne base SQLite locale et fichiers d'upload (obsolètes : la persistance
# se fait désormais sur Supabase — Postgres + Storage). Ne jamais committer de
# données réelles de clients/candidats dans le dépôt.
data/
uploads/

# Sauvegardes de la base (contiennent des données réelles de candidats/contacts) :
# jamais dans le dépôt, uniquement livrées directement à l'utilisateur.
backups/
backups_manual/

# Frontend compilé : reconstruit à chaque déploiement (voir "build" dans package.json).
/public/

# Scripts ponctuels d'import (contiennent des rapprochements nominatifs
# codés en dur avec des données réelles de clients/candidats) : jamais dans
# le dépôt, usage local unique au moment de l'import.
import/build_besoins.js
import/build_candidats.js
import/emit_candidats_sql.js
